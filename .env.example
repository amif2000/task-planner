# Copy this file to .env and replace the MongoDB connection placeholders.

# Frontend (read by Vite at build/dev time)
VITE_API_BASE_URL=http://localhost:3002

# Task Planner API
API_PORT=3002
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas (preferred connection format)
MONGODB_ATLAS_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority&appName=task-planner
MONGODB_DB_NAME=task_planner
MONGODB_COLLECTION_NAME=tasks
MONGODB_SETTINGS_COLLECTION_NAME=settings

# Production launcher
UI_PORT=4173
COMPANION_PORT=3001

# Alternative to MONGODB_ATLAS_URI:
# MONGODB_USERNAME=<username>
# MONGODB_PASSWORD=<password>
# MONGODB_URI=<cluster-host>
